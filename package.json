{
  "name": "signalguard",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.26",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest-expo": "~57.0.5",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "lint": "EXPO_NO_TELEMETRY=1 expo lint",
    "test": "TZ=Europe/Paris jest --runInBand",
    "test:native": "node scripts/native-tests.mjs",
    "test:web": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:native",
    "export:ios": "EXPO_NO_TELEMETRY=1 expo export --platform ios",
    "export:web": "SIGNALGUARD_INSPECTION=1 EXPO_NO_WEB_SETUP=1 EXPO_NO_TELEMETRY=1 expo export --platform web",
    "doctor": "EXPO_NO_TELEMETRY=1 npx expo-doctor"
  },
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
